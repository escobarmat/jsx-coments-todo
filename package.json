{
  "name": "jsx-todo-comments",
  "displayName": "JSX TODO Comments",
  "description": "Highlights TODO, FIXME, BUG, HACK, and NOTE comments inside JSX and TSX blocks.",
  "version": "0.0.2",
  "publisher": "MatiasAlejandroEscobar",
  "repository": {
    "type": "git",
    "url": "https://github.com/escobarmat/jsx-coments-todo"
  },
  "homepage": "https://github.com/escobarmat/jsx-coments-todo#readme",
  "bugs": {
    "url": "https://github.com/escobarmat/jsx-coments-todo/issues"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "jsx",
    "tsx",
    "react",
    "comments",
    "todo",
    "better comments"
  ],
  "galleryBanner": {
    "color": "#20252B",
    "theme": "dark"
  },
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "JSX TODO Comments",
      "properties": {
        "jsxTodoComments.colors": {
          "type": "object",
          "default": {
            "TODO": "#FFB000",
            "FIXME": "#FF4D4F",
            "BUG": "#FF2D2D",
            "HACK": "#FFD93D",
            "NOTE": "#4DA3FF"
          },
          "description": "Custom colors for supported JSX comment tags."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.5"
  }
}
